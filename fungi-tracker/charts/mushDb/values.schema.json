{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Values",
  "type": "object",
  "required": [
    "dbPath",
    "picsPathAbsolute",
    "dbRoot",
    "dbUser",
    "rfidSecret",
    "externalhost",
    "localPort",
    "nodeSelector",
    "googleClientId",
    "googleClientSecret"
  ],
  "properties": {
    "dbName": {"type": "string"},
    "dbPath": {"type": "string","format": "absolutePath"},
    "dbRoot": {
      "type": "object",
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {"type": "string"},
        "passwword": {"type": "string"}
      }
    },
    "dbUser": {
      "type": "object",
      "required": [
        "username",
        "password"
      ],
      "properties": {
        "username": {"type": "string"},
        "passwword": {"type": "string"}
      }
    },
    "picsPathAbsolute": {"type": "string","format": "absolutePath"},
    "googleClientId": {"type":  "string"},
    "googleClientSecret": {"type":  "string"},
    "rfidSecret": {"type": "string"},
    "applicationNameOverride": {"type": "string"},
    "externalhost": {
      "description": "Either a domain, or a domain with a port",
      "type": "string"
    },
    "nodeSelector": {"type": "object"}
  }
}