    "cloudflareSubdomains",
    "cloudflareZoneId",
    "cloudflareApiToken"
  ],
  "properties": {
    "cloudflareSubdomains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "cloudflareZoneId": {
      "type": "string"
    },
    "cloudflareApiToken": {
      "type": "string"
    },
